# Copy this file to `.env` and fill in real values.
# Docker Compose automatically reads `.env` from the repo root.

# Required: OpenAI key used by backend service.
OPENAI_API_KEY=your_openai_api_key_here

# Optional overrides.
CORS_ALLOWED_ORIGIN=http://localhost:5173
TRACEAI_CONNECTION_STRING=Data Source=/app/data/traceai.db
VITE_API_BASE_URL=http://localhost:5000/api
VITE_HUB_URL=http://localhost:5000/hubs/execution
