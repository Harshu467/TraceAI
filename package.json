{
  "name": "traceai",
  "version": "1.0.0",
  "description": "AI execution engine with traceable steps",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && npm run build:client",
    "build:client": "webpack --mode=production",
    "start": "node dist/server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "ts-node src/server.ts",
    "dev:client": "webpack serve --mode=development"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.15",
    "concurrently": "^8.2.0",
    "css-loader": "^6.8.1",
    "html-webpack-plugin": "^5.5.3",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.4.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "webpack": "^5.88.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "react": "^18.2.37",
    "react-dom": "^18.2.37"
  },
  "keywords": ["ai", "execution", "engine"],
  "author": "",
  "license": "ISC"
}