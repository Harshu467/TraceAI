{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=traceai.db"
  },
  "OpenAI": {
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1"
  },
  "Auth": {
    "JwtIssuer": "traceai-api",
    "JwtAudience": "traceai-frontend",
    "JwtSigningKey": "replace-this-key-with-32-plus-bytes",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "GoogleOAuth": {
    "ClientId": "",
    "ClientSecret": ""
  },
  "Otp": {
    "CodeLength": 6,
    "ExpiryMinutes": 10,
    "ResendCooldownSeconds": 60,
    "MaxAttempts": 5
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
